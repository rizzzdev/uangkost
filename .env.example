# ============================================================
# uangkost — Docker Compose variables
# Salin sebagai .env di ROOT project lalu sesuaikan.
# ============================================================

# Domain utama untuk Traefik (mis. rizzz.dev → https://uangkost.rizz.dev)
DOMAIN_NAME=rizz.dev

# URL publik frontend (dipakai backend untuk CORS & link WA reminder)
PUBLIC_URL=https://uangkost.rizz.dev

# Koneksi DB & Redis yang bisa dijangkau container backend.
# Gunakan hostname service bila DB/Redis ikut di-compose,
# atau host eksternal (mis. di network "backend").
DATABASE_URL=postgresql://postgres:password@postgres:5432/uang_kost
REDIS_URL=redis://redis:6379
