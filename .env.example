# ============================================================
# uangkost — Environment (root, dipakai docker compose)
# Salin ke .env lalu sesuaikan:  cp .env.example .env
# ============================================================

# Domain induk tempat aplikasi di-deploy (TANPA subdomain).
# Frontend: https://uangkost.${DOMAIN_NAME}  ·  API: https://api.uangkost.${DOMAIN_NAME}
DOMAIN_NAME=example.com

# Domain cookie bersama lintas subdomain — HARUS SAMA di backend & frontend.
# Diisi domain induk (mis. "example.com") agar cookie login berlaku untuk
# uangkost.example.com DAN api.uangkost.example.com.
# Kosongkan hanya untuk development (localhost, cookie host-only).
COOKIE_DOMAIN=example.com

# URL publik frontend (dipakai backend untuk CORS + link reminder WA)
PUBLIC_URL=https://uangkost.${DOMAIN_NAME}

# Koneksi database & redis dari perspektif container
DATABASE_URL=postgresql://postgres:password@postgres:5432/uang_kost
REDIS_URL=redis://redis:6379
