# ===================================================
# uangkost — Unified Environment Configuration (.env)
# Satu sumber konfigurasi terpusat untuk Local & Docker
# ===================================================

# --- Domain Utama (Production VPS & Cookie Subdomain) ---
# Mengubah DOMAIN_NAME otomatis memperbarui Traefik & Cookie Domain di seluruh aplikasi
DOMAIN_NAME=domain.com
COOKIE_DOMAIN="${DOMAIN_NAME}"

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:nightwitch96@localhost:5433/uang_kost"

# --- Redis (BullMQ + Cache) ---
REDIS_URL="redis://localhost:6380"

# --- Server & Timezone ---
PORT=4000
NODE_ENV=production
TZ=Asia/Jakarta

# --- Frontend & Backend URLs ---
PUBLIC_URL="http://localhost:4001"
PUBLIC_API_URL="http://localhost:4000/api"

# --- Upload Directory ---
UPLOAD_DIR="./uploads"

# --- Admin Authentication (Sentri) ---
JWT_SECRET="ini-secre-key-yang-sangat-kuat-banget-untuk-admin-authentication"
SENTRI_API_KEY="ini-sentri-api-key-kuat-banget-suerrrrrr"

# --- WhatsApp Gateway (Fonnte) ---
FONNTE_TOKEN="1fWmDr4may9G87mW3aPa"

# --- Time to Live (TTL) Config ---
PORTAL_TOKEN_TTL_DAYS=90
TENANT_SESSION_TTL_DAYS=30
