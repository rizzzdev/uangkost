# ======================
# uangkost — Frontend Env
# Salin ke frontend/.env lalu sesuaikan:  cp .env.example .env
# ======================

# URL API — Lokal: http://localhost:4000/api
# Produksi: https://api.uangkost.<domain>/api  (URL publik yang bisa diakses browser)
PUBLIC_API_URL="http://localhost:4000/api"

# Domain cookie bersama lintas subdomain — HARUS sama dengan COOKIE_DOMAIN backend.
# Produksi: domain induk (mis. "example.com") agar cookie login berlaku untuk
# uangkost.example.com & api.uangkost.example.com. Kosongkan hanya di development.
COOKIE_DOMAIN=""
