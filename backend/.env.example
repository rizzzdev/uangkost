# ======================
# uangkost — Backend Env
# Salin ke backend/.env lalu sesuaikan:  cp .env.example .env
# ======================

# --- Database (PostgreSQL) ---
# Lokal (development): host localhost. Docker: host = nama service postgres
# di network "backend" (mis. postgres:5432) — sesuaikan saat deploy.
DATABASE_URL="postgresql://postgres:password@localhost:5432/uang_kost"

# --- Redis (BullMQ + cache) ---
# Lokal (development): host localhost. Docker: host = nama service redis
# di network "backend" (mis. redis:6379) — sesuaikan saat deploy.
REDIS_URL="redis://localhost:6379"

# --- Frontend URL (dipakai CORS & link WA reminder: portal & laporan) ---
# Produksi wajib diisi URL publik frontend, mis. https://uangkost.example.com
PUBLIC_URL="http://localhost:4001"

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Upload ---
UPLOAD_DIR="./uploads"

# --- Cookie bersama lintas subdomain (wajib saat produksi) ---
# Domain induk (mis. "example.com") agar cookie login berlaku untuk
# uangkost.example.com DAN api.uangkost.example.com.
# HARUS sama dengan COOKIE_DOMAIN di frontend/.env. Kosongkan hanya di development.
COOKIE_DOMAIN=""

# --- Sesi Portal Penghuni ---
# Lama berlaku link portal (hari) & lama sesi cookie tenant (hari).
PORTAL_TOKEN_TTL_DAYS=90
TENANT_SESSION_TTL_DAYS=30

# --- Admin Authentication (Sentri) ---
# WAJIB ganti dengan secret acak yang kuat saat produksi (min. 32 karakter)
JWT_SECRET="ganti-dengan-secret-acak-panjang-minimal-32-karakter"
# API key aplikasi (identitas klien untuk Sentri). WAJIB diisi di produksi.
SENTRI_API_KEY="sk_..._ganti_di_produksi"

# --- WhatsApp (Fonnte) ---
FONNTE_TOKEN=""
