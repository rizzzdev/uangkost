# ======================
# uangkost — Backend Env
# ======================

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:nightwitch96@localhost:5433/uang_kost"

# --- Redis (BullMQ + cache) ---
REDIS_URL="redis://localhost:6380"

# --- Frontend App URL (dipakai untuk CORS & link WA reminder: portal & laporan) ---
# Produksi: ganti dengan URL frontend yang sebenarnya, mis. https://rizzz.dev
PUBLIC_URL="http://localhost:4001"

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Upload ---
UPLOAD_DIR="./uploads"

# --- Admin Authentication (Sentri) ---
# WAJIB ganti dengan secret acak yang kuat saat produksi (min. 32 karakter)
JWT_SECRET="ini-secre-key-yang-sangat-kuat-banget-untuk-admin-authentication"
# API key aplikasi (identitas klien untuk Sentri). WAJIB diisi di produksi —
# nilai fallback di kode hanya untuk development.
SENTRI_API_KEY="ini-sentri-api-key-kuat-banget-suerrrrrr"

